{
  "name": "proxybaby",
  "version": "0.2.0",
  "description": "Free & open-source HTTP(S) proxy debugger for macOS / Windows / Linux with a built-in AI/SSE beautifier.",
  "author": {
    "name": "imcuttle",
    "email": "imcuttle@163.com",
    "url": "https://github.com/imcuttle"
  },
  "homepage": "https://github.com/imcuttle/proxybaby",
  "repository": {
    "type": "git",
    "url": "https://github.com/imcuttle/proxybaby.git"
  },
  "license": "MIT",
  "main": "dist-electron/main.js",
  "type": "module",
  "bin": {
    "proxybaby": "bin/proxybaby.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:dir": "vite build && electron-builder --dir",
    "install:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir -c.mac.identity=null && node scripts/install-mac.cjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vite build && playwright test tests/e2e",
    "test:all": "vitest run && vite build && playwright test tests/e2e",
    "changeset": "changeset",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-table": "^8.20.0",
    "@tanstack/react-virtual": "^3.10.0",
    "clsx": "^2.1.1",
    "is-hotkey": "^0.2.0",
    "lucide-react": "^0.454.0",
    "monaco-editor": "^0.56.0",
    "node-forge": "^1.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.0",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "slate": "^0.126.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.126.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "build": {
    "appId": "com.proxybaby.app",
    "productName": "ProxyBaby",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "bin/proxybaby.cjs",
        "to": "bin/proxybaby.cjs"
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.5.0",
    "@types/node-forge": "^1.3.11",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "playwright": "^1.62.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.10"
  }
}
